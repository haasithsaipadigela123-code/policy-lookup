{
  "manifest_version": 3,
  "name": "Policy",
  "version": "1.0.0",
  "description": "Identifies relevant support policies for tickets on active web pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Policy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "policies.json",
        "importer.html",
        "importer.js",
        "importer.css",
        "docx-table-parser.js",
        "lib/jszip.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
